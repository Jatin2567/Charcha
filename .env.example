# Docker Compose reads this file after you copy it to .env.
# For local uv/npm development, copy server/.env.example to server/.env instead.
CHARCHA_MODE=demo
GNANI_API_KEY=
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Configure the private endpoint reachable from the API process after GPU approval.
# See docs/GPU_TESTING.md; the obsolete local-evon Compose profile was removed.
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Nalini
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Only needed for optional local open-weight model download after accepting its terms.
HF_TOKEN=

# Daily application reservations; zero blocks that resource. See docs/CREDIT_CONTROLS.md.
USAGE_DB_PATH=/app/data/usage.sqlite3
USAGE_STT_SECONDS_PER_DAY=600
USAGE_STT_CONNECTIONS_PER_DAY=30
USAGE_MT_REQUESTS_PER_DAY=100
USAGE_MT_CHARACTERS_PER_DAY=30000
USAGE_TTS_REQUESTS_PER_DAY=100
USAGE_TTS_CHARACTERS_PER_DAY=30000
USAGE_VOICE_ENROLLMENTS_PER_DAY=3
USAGE_MAX_CONCURRENT_STT=3
USAGE_MAX_CONCURRENT_OPERATIONS=2
USAGE_MAX_QUEUED_OPERATIONS=16
USAGE_PROVIDER_ADMISSION_TIMEOUT_SECONDS=5
USAGE_STT_MAX_RETRIES=3
USAGE_MAX_LIVE_ROOM_SECONDS=900
