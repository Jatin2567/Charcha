FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY server/pyproject.toml ./
COPY server/artha_mesh ./artha_mesh
RUN pip install --no-cache-dir '.[live]'
RUN useradd --create-home --uid 10001 artha
USER artha
EXPOSE 8000
CMD ["uvicorn", "artha_mesh.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--log-level", "warning"]
