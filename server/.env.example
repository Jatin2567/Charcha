# Copy into server/.env. API keys never belong in the web application.
ARTHA_MODE=demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required together for live mode. LiveKit Cloud or your self-hosted server.
LIVEKIT_URL=
# Optional worker-only URL inside containers; browser still receives LIVEKIT_URL.
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GNANI_API_KEY=

# Evon open weights must be hosted behind an OpenAI-compatible chat endpoint.
# Example: http://localhost:8001/v1. Provide the model ID served by that deployment.
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=

# Current documented Gnani endpoints; override only for a trusted deployment.
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_EMBEDDING_URL=https://api.vachana.ai/api/v1/tts/voice-clone/embeddings
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Nalini
VOICE_CLONE_MODEL=vachana-vc-v1

# One process owns each in-memory room. Keep one uvicorn worker.
MAX_PARTICIPANTS=8
ROOM_TTL_SECONDS=14400
SESSION_TTL_SECONDS=14400
PROVIDER_TIMEOUT_SECONDS=45
MAX_PENDING_TURNS=8
MAX_ROOMS=100

# Credit safeguards: global application reservations per UTC day, not vendor balances.
# Zero disables a resource. No unlimited default. Failed attempts stay counted.
# Defaults store date/resource/count only in server/data/usage.sqlite3; keep it persistent.
# Optional absolute path override: USAGE_DB_PATH=C:/your/persistent/path/usage.sqlite3
USAGE_STT_SECONDS_PER_DAY=600
USAGE_STT_CONNECTIONS_PER_DAY=30
USAGE_MT_REQUESTS_PER_DAY=100
USAGE_MT_CHARACTERS_PER_DAY=30000
USAGE_TTS_REQUESTS_PER_DAY=100
USAGE_TTS_CHARACTERS_PER_DAY=30000
USAGE_VOICE_ENROLLMENTS_PER_DAY=3
USAGE_MAX_CONCURRENT_STT=3
USAGE_MAX_CONCURRENT_OPERATIONS=2
USAGE_MAX_QUEUED_OPERATIONS=16
USAGE_PROVIDER_ADMISSION_TIMEOUT_SECONDS=5
USAGE_STT_MAX_RETRIES=3
USAGE_MAX_LIVE_ROOM_SECONDS=900
