# Copy into server/.env. API keys never belong in the web application.
CHARCHA_MODE=demo

# Local-only experiments. dev:local enables the lab and monitor mode in child
# processes without changing this file. Enforcement holds ~4.04s before compute.
LOCAL_AUDIO_LAB_ENABLED=false
AUDIO_SCREENING_MODE=off
# CPU tuning only; the 64,600-sample evidence window and thresholds stay fixed.
AUDIO_SCREENING_CPU_THREADS=1
# Optional override; otherwise server/models/aasist/model.onnx is used.
# AUDIO_SCREENING_MODEL_PATH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required together for live mode. Self-hosted LiveKit needs no Cloud account/credits.
# Production: public wss:// hostname; use exact HTTPS frontend origins above.
LIVEKIT_URL=
# Optional worker-only URL inside containers; browser still receives LIVEKIT_URL.
LIVEKIT_INTERNAL_URL=
# Generate matching API key/secret in your LiveKit server and this file.
# Use a random secret of at least 32 characters; do not reuse devkey/secret.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GNANI_API_KEY=
# Optional streaming STT selector: prisma-v2.5 or prisma-v3.0. Leave unset to
# preserve the provider default; a requested model is not an acknowledged model.
# GNANI_STT_MODEL=prisma-v3.0

# Evon must run behind the OpenAI-compatible /chat/completions adapter used here.
# Self-host its weights on GPU, or obtain approved hosted access plus the actual
# endpoint URL, exact model ID, auth details and API contract from the provider.
# Gnani hosted Evon beta access/credit eligibility is account-specific; a Gnani key
# alone does not establish compatible Evon access. No endpoint/schema is assumed.
# Example for a private GPU service: http://evon:8001/v1.
# Use HTTPS for external endpoints; put secrets only in EVON_API_KEY, never the URL.
EVON_BASE_URL=
EVON_SERVERLESS=false
# Hosted interpreted meetings require a consented own-voice reference before unmute.
VOICE_CLONING_REQUIRED=false
EVON_API_KEY=
# Optional Modal proxy credentials; supply both, only for an HTTPS *.modal.run endpoint.
# Keep these separate from EVON_API_KEY (the vLLM Bearer key) and the Gnani key.
EVON_MODAL_KEY=
EVON_MODAL_SECRET=
EVON_MODEL=
# Verified-email automatic reviewer access. Exact domain only, never suffix matching.
# Blank disables automatic grants; other verified accounts request admin approval.
REVIEWER_AUTO_DOMAINS=gnani.ai
REVIEWER_AUTO_ACCESS_HOURS=168
REVIEWER_AUTO_SHARED_RESOURCES=true
# Optional reviewer-owned Evon hosts, reviewed by the operator. Exact public
# HTTPS origins only; Modal *.modal.run is already allowed. Never add localhost,
# internal/metadata addresses, or a host whose DNS can point into private networks.
# REVIEWER_GPU_ALLOWED_ORIGINS=https://evon.example.org

# Current documented Gnani endpoints; override only for a trusted deployment.
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_EMBEDDING_URL=https://api.vachana.ai/api/v1/tts/voice-clone/embeddings
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Nalini
# Optional overrides for the selected model; v2.5 stock-voice examples:
TIMBRE_VOICE_HI=Nalini
TIMBRE_VOICE_TA=Trisha
TIMBRE_VOICE_BN=Kirra
TIMBRE_VOICE_EN=Pranav
TIMBRE_VOICE_TE=Suhana
TIMBRE_VOICE_KN=Saanvi
TIMBRE_VOICE_ML=Reshma
TIMBRE_VOICE_MR=Zahira
TIMBRE_VOICE_GU=Falak
TIMBRE_VOICE_PA=Mehuli
# Explicit language overrides take priority. If unset, v2.5 uses the catalog
# above when TIMBRE_VOICE stays Nalini; a custom TIMBRE_VOICE is the fallback.
# When changing TIMBRE_MODEL, choose voices from that model's own catalog.
VOICE_CLONE_MODEL=vachana-vc-v1

# One process owns each in-memory room. Keep one uvicorn worker.
MAX_PARTICIPANTS=8
# Set MAX_PARTICIPANTS=0 to remove the product cap; hardware/provider capacity still applies.
ROOM_TTL_SECONDS=14400
SESSION_TTL_SECONDS=14400
PROVIDER_TIMEOUT_SECONDS=45
MAX_PENDING_TURNS=8
MAX_ROOMS=100

# Credit safeguards: global application reservations per UTC day, not vendor balances.
# Every paid flow also requires an explicit short-lived operator grant.
USAGE_REQUIRE_FLOW_APPROVAL=true
# Public deployments keep manual financial evidence hidden. Enable only for a
# local operator API bound to 127.0.0.1; no operator browser sign-in is implemented.
USAGE_SHOW_PRIVATE_BALANCE=false
# Optional reference prices from your actual account's pricing table, not billing:
# USAGE_STT_INR_PER_HOUR=27
# USAGE_TTS_INR_PER_10000_CHARACTERS=27
# Zero disables a resource. No unlimited default. Failed attempts stay counted.
# The ledger stores numeric usage, bounded grants and optional manual balance evidence.
# Keep server/data/usage.sqlite3 persistent and private.
# Optional absolute path override: USAGE_DB_PATH=C:/your/persistent/path/usage.sqlite3
USAGE_STT_SECONDS_PER_DAY=600
USAGE_STT_CONNECTIONS_PER_DAY=30
USAGE_MT_REQUESTS_PER_DAY=100
USAGE_MT_CHARACTERS_PER_DAY=30000
USAGE_TTS_REQUESTS_PER_DAY=100
USAGE_TTS_CHARACTERS_PER_DAY=30000
USAGE_VOICE_ENROLLMENTS_PER_DAY=3
USAGE_MAX_CONCURRENT_STT=3
USAGE_MAX_CONCURRENT_OPERATIONS=2
USAGE_MAX_QUEUED_OPERATIONS=16
USAGE_PROVIDER_ADMISSION_TIMEOUT_SECONDS=5
USAGE_STT_MAX_RETRIES=3
USAGE_MAX_LIVE_ROOM_SECONDS=900

# Identity settings are server-only. Supply values in the private environment.
# For LAN or production use the exact HTTPS web origin including any port.
CHARCHA_PUBLIC_ORIGIN=http://localhost:5180
CHARCHA_AUTH_DOMAIN=
CHARCHA_AUTH_CLIENT_ID=
CHARCHA_AUTH_CLIENT_SECRET=
CHARCHA_MEETING_HOST_EMAIL=
CHARCHA_ADMIN_SUBJECT=
CHARCHA_ADMIN_CONNECTION=Username-Password-Authentication

# India-hosted sign-in. The issuer is the realm URL on your own HTTPS host.
# CHARCHA_IDENTITY_PROVIDER=keycloak
# CHARCHA_OIDC_ISSUER=https://meet.your-domain.in/identity/realms/charcha
